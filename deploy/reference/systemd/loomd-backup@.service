# GENERATED by scripts/render_host_profile.py from deploy/reference/profile.json.
# Do not edit by hand: `python3 scripts/verify_host_profile.py` fails on drift.
# Signed backup of the point-in-time clone for tenant %i.
#
# Runs as loomd-backup: the writer is the only identity that can read the signing key, and the
# verifier is the only identity that reads the trust root. A single account doing both would make
# the independent check a formality.
[Unit]
Description=loomDB signed backup of the point-in-time clone for tenant %i
Documentation=file:///usr/share/doc/loomdb/backup-restore.md
# The point-in-time clone must be mounted; an absent source stops the unit rather than
# signing an empty backup. The live store is deliberately not named here: loomd holds an
# exclusive lock on it and this job could not read it.
RequiresMountsFor=/var/lib/loomd-source

[Service]
Type=oneshot
User=loomd-backup
Group=loomd-backup
EnvironmentFile=/etc/loomd/loomd-%i.env
EnvironmentFile=/etc/loomd/backup.env
ExecStart=/usr/local/bin/loomctl backup-signed \
    --path /var/lib/loomd-source \
    --tenant ${LOOM_TENANT} \
    --root /var/backups/loomd/%i \
    --signing-key-file /etc/loomd/backup-signing/backup-root.hex \
    --key-id backup-root-2026-q3 \
    --metrics-file /var/lib/loomd-metrics/%i-backup.prom

# Same hardening as the engine unit. A backup job reads a database and writes a signed copy; it
# needs no privilege, no network, and no path outside what it was given.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/backups/loomd /var/lib/loomd-metrics
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot @module @debug
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
