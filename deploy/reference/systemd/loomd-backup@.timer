# GENERATED by scripts/render_host_profile.py from deploy/reference/profile.json.
# Do not edit by hand: `python3 scripts/verify_host_profile.py` fails on drift.
# Schedule for signed backup of the point-in-time clone, tenant %i.
#
# OnCalendar mirrors the Kubernetes flavour's cron expression '17 2 * * *'. Persistent=true
# so a host that was down over the window runs the job when it comes back rather than skipping it
# silently — a missed backup nobody was told about is the failure this whole increment exists to
# make loud.
[Unit]
Description=Schedule loomDB signed backup of the point-in-time clone for tenant %i

[Timer]
OnCalendar=*-*-* 02:17:00
Persistent=true
RandomizedDelaySec=300
Unit=loomd-backup@%i.service

[Install]
WantedBy=timers.target
