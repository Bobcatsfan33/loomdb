# GENERATED by scripts/render_host_profile.py from deploy/reference/profile.json.
# Do not edit by hand: `python3 scripts/verify_host_profile.py` fails on drift.
# Tenant 'beta'. One tenant, one store, one process.
LOOM_TENANT=beta-industries
LOOM_DATA_DIR=/var/lib/loomd/beta
# Deny-by-default from the externally managed, read-only policy mount.
LOOM_POLICY_FILE=/etc/loomd/policy/beta.json
# Write authenticity: loomd opens the store attested, so every write is verified against the
# governance-signed actor registry. Dropping any of these three stops the unit rather than
# downgrading it to unauthenticated writes.
LOOM_ACTOR_REGISTRY_FILE=/etc/loomd/actors/beta.json
LOOM_ACTOR_GOVERNANCE_KEY_FILE=/etc/loomd/trust/actor-governance-trust-roots.json
LOOM_ACTOR_MIN_GENERATION=1
LOOM_MAX_REQUEST_BYTES=1048576
LOOM_REQUESTS_PER_SECOND=100
LOOM_REQUEST_BURST=200
# No telemetry: the air-gap build has no OTLP exporter compiled in, and the unit denies
# all outbound addresses. Enabling it needs the connected build, an IPAddressAllow line
# for the collector, and AF_INET in RestrictAddressFamilies.
